					"name": "5.4 Verify / Approve Payment",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"approved\",\n    \"adminRemarks\": \"Payment confirmed\"\n}"
						},
