					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "qrImage", "type": "file", "src": "" },
								{ "key": "title", "value": "Pandit Ji UPI QR", "type": "text" },
								{ "key": "upiId", "value": "acharyadev@oksbi", "type": "text" },
