					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"CONFIRMED\"\n}"
						},
						"url": "https://astrobackend.bhoomitechzone.shop/api/appointments/{{appointmentId}}/status"
					}
				}
			]
