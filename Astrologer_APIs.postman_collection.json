		{
			"name": "4. Appointments",
			"item": [
				{
					"name": "4.1 Book Appointment (User)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"astrologerId\": \"{{astrologerUserId}}\",\n    \"appointmentDate\": \"2026-11-28\",\n    \"timeSlot\": \"04:00 PM - 04:30 PM\",\n    \"consultationMode\": \"chat\",\n    \"notes\": \"Career guidance\"\n}"
						},
						"url": "https://astrobackend.bhoomitechzone.shop/api/appointments/book"
					}
				},
				{
					"name": "4.2 Get Astrologer's Appointments",
					"request": {
						"method": "GET",
						"url": "https://astrobackend.bhoomitechzone.shop/api/appointments/astrologer/{{astrologerUserId}}"
					}
				},
